# Copie ce fichier en ".env" et remplis-le. NE JAMAIS committer le .env rempli.

# --- Oxylabs (identifiants ISP) ---
OXY_USER=customer-stephane_maurois_BZaIT
# Si le mot de passe contient des caracteres speciaux (@ : / etc.),
# encode-les en URL (ex: @ -> %40).
OXY_PASS=MOT_DE_PASSE_OXYLABS
# Le PORT = l'IP fixe du groupe (8001 -> 31.98.21.135, 8002 -> 31.98.21.139, ...).
OXY_PORT_G1=8001

# --- Fingerprint commun du groupe (identique sur tous les sieges) ---
FP_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
FP_TZ=Europe/Paris

# --- Portail (page de connexion) ---
PORTAL_DOMAIN=talens.pixfeed.net
PORTAL_USER=equipe
# Mot de passe du portail EN CLAIR (verifie par le service d'auth, cote serveur).
PORTAL_PASSWORD=ChoisisUnMotDePasse
# Cle secrete pour signer les cookies de session (longue chaine aleatoire).
# Genere-la avec :  openssl rand -hex 32
SESSION_SECRET=REMPLACE_PAR_UNE_LONGUE_CHAINE_ALEATOIRE
