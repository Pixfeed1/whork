# Copie ce fichier en ".env" et remplis-le. NE JAMAIS committer le .env rempli.

# --- Fingerprint commun du groupe (identique sur tous les sieges) ---
FP_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
FP_TZ=Europe/Paris

# --- Postes a la demande (economise le serveur sur beaucoup de consultants) ---
# ONDEMAND=1 : un navigateur ne tourne QUE quand son consultant est connecte,
#              et s'arrete apres IDLE_MINUTES sans activite. Ideal des qu'il y a
#              beaucoup de comptes mais peu de monde en meme temps.
# ONDEMAND=0 (defaut) : tous les postes tournent en permanence.
ONDEMAND=0
IDLE_MINUTES=5

# Memoire max par navigateur (garde-fou pour qu'un poste n'affame pas les autres).
SEAT_MEM=3g

# --- Interface d'administration ---
# Les licences et les comptes consultants se gerent depuis la page /admin
# (stockes dans config.json, pas ici).
#
# Compte administrateur (acces a l'interface /admin).
ADMIN_USER=admin
ADMIN_PASSWORD=ChoisisUnMotDePasseAdmin

# Cle secrete pour signer les cookies de session (longue chaine aleatoire).
# Genere-la avec :  openssl rand -hex 32
SESSION_SECRET=REMPLACE_PAR_UNE_LONGUE_CHAINE_ALEATOIRE