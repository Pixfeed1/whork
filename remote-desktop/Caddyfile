# Routeur interne (HTTP seul, port 8080). Le HTTPS de talens.pixfeed.net est
# gere par cPanel/Apache en frontal, qui redirige ici.
#
# Auth par formulaire (service "auth") : cookie de session, chaque utilisateur
# n'accede qu'a SON poste (verifie via forward_auth -> /verify).

:8080 {
	# Pages publiques (connexion / deconnexion).
	@public path /login /login/* /logout
	handle @public {
		reverse_proxy auth:9000
	}

	# Tout le reste est protege.
	handle {
		forward_auth auth:9000 {
			uri /verify
		}

		handle_path /s1/* { reverse_proxy seat-1:3000 }
		handle_path /s2/* { reverse_proxy seat-2:3000 }
		handle_path /s3/* { reverse_proxy seat-3:3000 }
		handle_path /s4/* { reverse_proxy seat-4:3000 }

		# Portail personnel (servi par le service auth).
		handle {
			reverse_proxy auth:9000
		}
	}
}
