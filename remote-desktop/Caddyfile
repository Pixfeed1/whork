# Routeur interne (HTTP seul, port 8080). Pas de TLS ici : c'est le serveur
# web en frontal (cPanel/Apache, ou Cloudflare Tunnel) qui gère le HTTPS de
# talens.pixfeed.net et redirige vers ce port.

:8080 {
	# Login unique pour accéder au portail et aux sièges.
	basicauth {
		{$PORTAL_USER} {$PORTAL_PASS_HASH}
	}

	# Siège 1 -> navigateur du consultant 1 (Selkies/noVNC sur le port 3000).
	handle_path /s1/* {
		reverse_proxy seat-1:3000
	}

	# Siège 2 -> navigateur du consultant 2.
	handle_path /s2/* {
		reverse_proxy seat-2:3000
	}

	# Page d'accueil du portail (charte de l'extension).
	handle {
		root * /srv/portal
		file_server
	}
}
