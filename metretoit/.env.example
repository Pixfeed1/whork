# Port HTTP du serveur
PORT=3000
# URL publique (liens de retour Stripe)
PUBLIC_URL=https://metretoit.exemple.fr
# Dossier des données (base SQLite) — à placer sur un volume persistant
DATA_DIR=./data
# Secret de signature des sessions (32+ caractères aléatoires). Généré automatiquement si absent.
AUTH_SECRET=
# Mettre à false pour fermer les inscriptions publiques après création du premier compte
ALLOW_SIGNUP=true

# --- Google Maps Platform (optionnel) ---
# Active Google Solar API (relevé 3D + contrôle des pans) et le géocodage hors France.
# APIs à activer dans la console Google Cloud : Solar API, Geocoding API.
GOOGLE_MAPS_API_KEY=
# Clé « navigateur » pour la photo satellite Google de l'éditeur (Maps JavaScript API seule,
# restreinte aux sites web https://<votre-domaine>/*). Elle est visible dans le navigateur : c'est normal.
GOOGLE_MAPS_BROWSER_KEY=

# --- Abonnements Stripe (optionnel, pour commercialiser l'application) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRICE_LABEL=49 € HT / mois
# études offertes pendant l'essai, puis quota mensuel de l'abonnement (0 = illimité)
TRIAL_STUDIES=5
PRO_MONTHLY_STUDIES=0

# --- E-mails (optionnel) : lien « mot de passe oublié » ---
# Sans SMTP, l'utilisateur est invité à demander un nouveau mot de passe au responsable du compte.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MétréToit <noreply@exemple.fr>"

# --- Pages légales (mentions légales, CGU, confidentialité) ---
# Les champs vides apparaissent surlignés « à compléter » sur les pages.
LEGAL_COMPANY=
LEGAL_FORM=
LEGAL_CAPITAL=
LEGAL_ADDRESS=
LEGAL_SIRET=
LEGAL_RCS=
LEGAL_VAT=
LEGAL_DIRECTOR=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_HOST=
LEGAL_UPDATED=
