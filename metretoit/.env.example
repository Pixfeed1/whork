# Port HTTP du serveur
PORT=3000
# URL publique (liens de retour Stripe)
PUBLIC_URL=https://metretoit.exemple.fr
# Dossier des données (base SQLite) — à placer sur un volume persistant
DATA_DIR=./data
# Secret de signature des sessions (32+ caractères aléatoires). Généré automatiquement si absent.
AUTH_SECRET=
# Mettre à false pour fermer les inscriptions publiques après création du premier compte
ALLOW_SIGNUP=true

# --- Google Maps Platform (optionnel) ---
# Active Google Solar API (relevé 3D + contrôle des pans) et le géocodage hors France.
# APIs à activer dans la console Google Cloud : Solar API, Geocoding API.
GOOGLE_MAPS_API_KEY=

# --- Abonnements Stripe (optionnel, pour commercialiser l'application) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRICE_LABEL=49 € HT / mois
# études offertes pendant l'essai, puis quota mensuel de l'abonnement (0 = illimité)
TRIAL_STUDIES=5
PRO_MONTHLY_STUDIES=0
