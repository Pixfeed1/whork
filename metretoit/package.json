{
  "name": "metretoit",
  "version": "1.0.0",
  "private": true,
  "description": "Métrage automatique de toiture à distance (LiDAR HD IGN + Google Solar API)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "precision": "tsx scripts/precision.ts",
    "e2e": "tsx scripts/e2e.ts",
    "test:all": "npm test && npm run build",
    "acces": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/acces.mjs",
    "compte": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/compte.mjs",
    "restart": "bash scripts/restart.sh",
    "update": "git pull && npm ci && npm run build && bash scripts/restart.sh"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "geotiff": "^3.0.5",
    "jose": "^6.2.17",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "proj4": "^2.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^6.19.0",
    "playwright": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
